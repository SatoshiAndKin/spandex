{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "custom.regex"
  ],
  "dependencyDashboard": {
    "enabled": false
  },
  "automerge": false,
  "ignoreUnstable": true,
  "prConcurrentLimit": 1,
  "separateMajorMinor": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^upstream-release\\.txt$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)(?:\\r?\\n|$)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "@spandex/core",
      "packageNameTemplate": "withfabricxyz/spandex",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^@spandex/core@(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$"
    }
  ],
  "prBodyNotes": [
    "Merge the upstream `@spandex/core` release tag into this branch before merging the PR.",
    "Run the fork QA suite and confirm quote cancellation still works. Update the Compare DEX Routers commit pin only after validating the fork revision."
  ]
}
