{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "declaration": false
  },
  "include": [
    "packages/**/*.ts",
      "packages/**/*.cts",
      "packages/**/*.mts",
    "packages/**/*.tsx"
  ],
  "exclude": [
    "packages/*/dist",
    "node_modules"
  ]
}
